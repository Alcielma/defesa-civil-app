# URL da API.
# Padrão local (backend rodando em http://127.0.0.1:8000).
# Para testes em dispositivo físico, use o IPv4
# da máquina que está executando o backend.
VITE_API_URL=http://127.0.0.1:8000
# Prefixo das rotas da API (padrão Laravel).
VITE_API_PREFIX=/api
# URL utilizada para conexão com o Socket (opcional).
VITE_SOCKET_URL=

# Habilita login por credenciais MOCK (desenvolvimento/demonstração).
# Quando 'false' (padrão recomendado para produção),
# o login só funciona com o backend real.
# Credenciais mock (se habilitado): agente@defesa-civil.com / 123456
VITE_ENABLE_MOCK_LOGIN=